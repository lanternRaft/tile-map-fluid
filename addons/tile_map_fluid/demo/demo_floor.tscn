[gd_scene format=3]

[ext_resource type="Texture2D" path="res://addons/tile_map_fluid/demo/floor.svg" id="texture"]
[ext_resource type="Script" path="res://addons/tile_map_fluid/wet_surface_2d.gd" id="surface"]
