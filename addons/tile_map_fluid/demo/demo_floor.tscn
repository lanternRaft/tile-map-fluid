[ext_resource type="Script" path="res://addons/tile_map_fluid/wet_surface_settings.gd" id="settings"]

[sub_resource type="TileSetAtlasSource" id="Atlas"]
texture = ExtResource("texture")
texture_region_size = Vector2i(32, 32)
0:0/0 = 0

[sub_resource type="TileSet" id="Tiles"]
tile_size = Vector2i(32, 32)
sources/0 = SubResource("Atlas")

[sub_resource type="Resource" id="Settings"]
script = ExtResource("settings")
dry_seconds = 18.0

[node name="Floor" type="TileMapLayer"]
z_index = -1
metadata/draw_order_exception = "ground"
metadata/draw_order_reason = "The authored dry floor supports all demo objects and physical water rows."
tile_set = SubResource("Tiles")
tile_map_data = PackedByteArray("")

[node name="Surface" type="Node2D" parent="." node_paths=PackedStringArray("tile_layer", "simulation")]
script = ExtResource("surface")
tile_layer = NodePath("..")
simulation = NodePath("Simulation")
